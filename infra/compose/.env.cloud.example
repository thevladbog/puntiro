# Compose interpolation and host-tool overlays. Copy to .env.cloud, set mode 0600, and populate locally.
# Runtime secrets belong in the separate ignored cloud-runtime.env file.

PUNTIRO_POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
PUNTIRO_CLOUD_IMAGE=
PUNTIRO_CLOUD_RUNTIME_ENV_FILE=
PUNTIRO_RESTORE_PROJECT=
Puntiro__Security__DataProtectionCertificateHostPath=

# Host-only overlays used by EF/provisioning/integration tests. Cloud reads its
# container connection from cloud-runtime.env instead.
PUNTIRO_TEST_POSTGRES=
ConnectionStrings__Puntiro=
